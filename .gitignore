# Graphify — artefacts régénérables (cache, HTML, rapport), sauf graph.json
# qui est versionné pour que les sessions distantes (Claude Code web/mobile)
# aient le graphe sans reconstruction. Merge driver dédié dans .gitattributes.
graphify-out/*
!graphify-out/graph.json
